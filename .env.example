# ═══════════════════════════════════════════════════════════════════════
# OmniDesk — переменные окружения
#
#   cp .env.example .env
#   chmod 600 .env
#
# Сгенерировать секрет:   openssl rand -base64 32
#
# ⚠️  .env НИКОГДА не коммитится. Проверьте, что он в .gitignore,
#     и поставьте gitleaks в pre-commit — см. scripts/install-gitleaks.sh
# ═══════════════════════════════════════════════════════════════════════

# ─── Домен и публичный адрес ────────────────────────────────────────────
# Пусто = режим polling: Telegram опрашивается сервисом poller, публичный
# адрес не нужен. Так работает локальная разработка.
#
# Заполнять только когда появится настоящий публичный HTTPS (туннель или
# домен). Непустое значение переводит Telegram на вебхуки, а Meta
# без него не работает вовсе.
DOMAIN=
PUBLIC_URL=

# ─── Хранилище вложений ─────────────────────────────────────────────────
# local — том Docker. Работает сразу, ничего настраивать не нужно.
# s3    — Cloudflare R2 или совместимое. Переключение не меняет код.
STORAGE_DRIVER=local

# Заполнять только при STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ─── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_DB=omnidesk
POSTGRES_USER=omnidesk
POSTGRES_PASSWORD=            # openssl rand -base64 32
# Отдельный пароль для непривилегированной роли, под которой работает
# приложение. Именно под ней действует RLS.
APP_DB_PASSWORD=              # openssl rand -base64 32

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=               # openssl rand -base64 32

# ─── Криптография приложения ────────────────────────────────────────────
JWT_SECRET=                   # openssl rand -base64 48
# Мастер-ключ, из которого выводятся ключи шифрования на каждого тенанта.
# Им шифруются токены каналов и refresh-токены Zoho в БД.
# ⚠️  Потеря = потеря доступа ко всем подключённым каналам всех клиентов.
#     Храните копию отдельно от сервера (менеджер паролей / KMS).
ENCRYPTION_MASTER_KEY=        # openssl rand -base64 32

# ─── Meta (WhatsApp, Instagram, Messenger) ──────────────────────────────
META_APP_ID=
META_APP_SECRET=              # им проверяется X-Hub-Signature-256
META_VERIFY_TOKEN=            # произвольная строка для верификации вебхука
META_CONFIG_ID=               # configuration_id для Embedded Signup
META_GRAPH_VERSION=v26.0

# ─── Telegram ───────────────────────────────────────────────────────────
# Секрет, который передаётся в setWebhook и приходит обратно
# в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=      # openssl rand -hex 32
# Опционально: свой telegram-bot-api сервер — снимает лимит на скачивание
# файлов (иначе getFile ограничен). Нужен для медиа-тяжёлого инбокса.
TELEGRAM_API_ROOT=https://api.telegram.org

# ─── Zoho CRM ───────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://omnidesk.example.com/oauth/zoho/callback
# Общий секрет между Deluge-функцией расширения и вашим API.
# Им подписывается запрос на выдачу сессии виджета.
ZOHO_WIDGET_SHARED_SECRET=    # openssl rand -base64 32
# Токен, передаваемый в Notification API при подписке (максимум 50 символов)
ZOHO_WEBHOOK_TOKEN=           # openssl rand -hex 20
# ⚠️ accounts_server и api_domain НЕ хардкодятся: они приходят в callback
#    (location / accounts-server) и в ответе на обмен токена (api_domain),
#    и сохраняются в таблицу zoho_installations на каждого клиента.

# ─── Объектное хранилище (Cloudflare R2) ────────────────────────────────
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=omnidesk-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ─── Cloudflare Tunnel ──────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → Create a tunnel → скопировать токен.
# Нужен, только если сервер без белого IP (локальная ВМ, дом, NAT).
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Бэкапы ─────────────────────────────────────────────────────────────
# Публичный ключ age. Приватный ключ на сервере НЕ хранить —
# иначе тот, кто получил сервер, получил и бэкапы.
#   age-keygen -o backup-key.txt   (приватный — в менеджер паролей)
BACKUP_AGE_PUBKEY=
# Remote в rclone.conf, куда льём. Права ключа: только запись, без удаления.
BACKUP_RCLONE_REMOTE=b2:omnidesk-backups

# ─── Наблюдаемость ──────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Воркеры ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── Centrifugo ─────────────────────────────────────────────────────────
CENTRIFUGO_TOKEN_HMAC_SECRET=   # openssl rand -base64 32
CENTRIFUGO_API_KEY=             # openssl rand -base64 32

# ─── Почта для кодов входа ───────────────────────────────────────────
# Пусто — коды входа печатаются в лог контейнера api:
#   docker compose logs api | Select-String "КОД ВХОДА"
# Это нормально для локальной проверки и недопустимо на боевом сервере.
#
# Формат строки: smtps://пользователь:пароль@хост:465
# Пароль с символами @ : / нужно закодировать (%40 %3A %2F).
SMTP_URL=
MAIL_FROM=OmniDesk <no-reply@example.com>
APP_NAME=OmniDesk
